<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx">

    <Pane minWidth="24" maxWidth="24"/>

    <VBox>
        <Pane minHeight="24" maxHeight="24"/>
        <Label fx:id="titleLabel" styleClass="font_size_25"/>
        <Pane minHeight="16" maxHeight="16"/>
        <HBox fx:id="buttonBox"/>
        <Pane minHeight="24" maxHeight="24"/>

        <HBox>
            <VBox>
                <ImageView fx:id="imageView" fitHeight="480" fitWidth="240"/>
                <Pane minHeight="24" maxHeight="24"/>
                <Button fx:id="actorsButton" text="Actors"/>
            </VBox>

            <Pane minWidth="24" maxWidth="24"/>
            <VBox>
                <Label fx:id="detailsLabel"/>
                <Pane minHeight="24" maxHeight="24"/>
                <VBox fx:id="trailerBox"/>
            </VBox>

        </HBox>
    </VBox>

</HBox>
