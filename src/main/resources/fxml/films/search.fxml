<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx">

    <Pane minHeight="24" maxHeight="24"/>

    <HBox>
        <Pane minWidth="24" maxWidth="24"/>
        <TextField fx:id="searchTextField" prefWidth="240"/>
        <Pane minWidth="12" maxWidth="12"/>
        <Button fx:id="searchButton" text="Search"/>
    </HBox>

    <ScrollPane prefWidth="1008" minHeight="1008" maxHeight="640">
        <HBox>
            <Pane minWidth="24" maxWidth="24"/>
            <Pane fx:id="contentPane" minWidth="960" maxWidth="960"/>
        </HBox>
    </ScrollPane>

</VBox>
